<!DOCTYPE html>
<html lang="en">
<head>
    <title>Checkbox dengan Perhitungan Otomatis</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
            background-color: #f5f5f5;
        }
        .container {
            background-color: white;
            padding: 20px;
            border-radius: 5px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            max-width: 600px;
        }
        .menu-group {
            margin: 20px 0;
            padding: 15px;
            background-color: #f9f9f9;
            border-left: 4px solid #ff6b6b;
        }
        .menu-item {
            margin: 10px 0;
        }
        input[type="checkbox"] {
            cursor: pointer;
            margin-right: 10px;
        }
        label {
            cursor: pointer;
        }
        .harga {
            float: right;
            font-weight: bold;
            color: #ff6b6b;
        }
        .summary {
            background-color: #fff3e0;
            padding: 15px;
            margin-top: 20px;
            border-radius: 4px;
        }
        .summary h3 {
            margin-top: 0;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        table td {
            padding: 8px;
            border-bottom: 1px solid #ddd;
        }
        table td:first-child {
            font-weight: bold;
            width: 150px;
            background-color: #ffe0b2;
        }
        table td:last-child {
            text-align: right;
            color: #ff6b6b;
            font-weight: bold;
        }
        .total {
            background-color: #ff6b6b !important;
            color: white !important;
        }
        button {
            padding: 10px 20px;
            background-color: #4CAF50;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            margin-top: 15px;
        }
        button:hover {
            background-color: #45a049;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Pesanan Menu Restoran</h1>
        <p>Pilih menu yang ingin dipesan dengan mencentang checkbox</p>

        <div class="menu-group">
            <h3>Menu Makanan</h3>
            
            <div class="menu-item">
                <input type="checkbox" id="nasi_goreng" value="20000" onchange="hitungTotal()">
                <label for="nasi_goreng">Nasi Goreng <span class="harga">Rp. 20.000</span></label>
            </div>

            <div class="menu-item">
                <input type="checkbox" id="soto_ayam" value="15000" onchange="hitungTotal()">
                <label for="soto_ayam">Soto Ayam <span class="harga">Rp. 15.000</span></label>
            </div>

            <div class="menu-item">
                <input type="checkbox" id="gado_gado" value="12000" onchange="hitungTotal()">
                <label for="gado_gado">Gado-Gado <span class="harga">Rp. 12.000</span></label>
            </div>

            <div class="menu-item">
                <input type="checkbox" id="lumpia" value="10000" onchange="hitungTotal()">
                <label for="lumpia">Lumpia <span class="harga">Rp. 10.000</span></label>
            </div>
        </div>

        <div class="menu-group">
            <h3>Menu Minuman</h3>
            
            <div class="menu-item">
                <input type="checkbox" id="jus_jeruk" value="8000" onchange="hitungTotal()">
                <label for="jus_jeruk">Jus Jeruk <span class="harga">Rp. 8.000</span></label>
            </div>

            <div class="menu-item">
                <input type="checkbox" id="teh_manis" value="5000" onchange="hitungTotal()">
                <label for="teh_manis">Teh Manis <span class="harga">Rp. 5.000</span></label>
            </div>

            <div class="menu-item">
                <input type="checkbox" id="kopi" value="7000" onchange="hitungTotal()">
                <label for="kopi">Kopi <span class="harga">Rp. 7.000</span></label>
            </div>
        </div>

        <div class="menu-group">
            <h3>Menu Dessert</h3>
            
            <div class="menu-item">
                <input type="checkbox" id="es_crim" value="12000" onchange="hitungTotal()">
                <label for="es_crim">Es Krim <span class="harga">Rp. 12.000</span></label>
            </div>

            <div class="menu-item">
                <input type="checkbox" id="puding" value="8000" onchange="hitungTotal()">
                <label for="puding">Puding <span class="harga">Rp. 8.000</span></label>
            </div>
        </div>

        <div class="summary">
            <h3>Ringkasan Pesanan</h3>
            <table>
                <tr>
                    <td>Jumlah Item</td>
                    <td id="jumlah_item">0</td>
                </tr>
                <tr>
                    <td>Total Harga</td>
                    <td id="total_harga">Rp. 0</td>
                </tr>
                <tr class="total">
                    <td>TOTAL BAYAR</td>
                    <td id="total_bayar">Rp. 0</td>
                </tr>
            </table>
        </div>

        <button onclick="pesanSekarang()">Pesan Sekarang</button>
        <button onclick="resetPesanan()" style="background-color: #f44336; margin-left: 10px;">Batal</button>
    </div>

    <script>
        function hitungTotal() {
            let checkboxes = document.querySelectorAll('input[type="checkbox"]:checked');
            let total = 0;
            let items = [];

            checkboxes.forEach(function(checkbox) {
                let harga = parseInt(checkbox.value);
                total += harga;
                
                // Ambil label terkait
                let label = document.querySelector('label[for="' + checkbox.id + '"]').textContent.split(/Rp\./)[0].trim();
                items.push(label);
            });

            // Update DOM
            document.getElementById("jumlah_item").textContent = checkboxes.length;
            document.getElementById("total_harga").textContent = "Rp. " + total.toLocaleString('id-ID');
            document.getElementById("total_bayar").textContent = "Rp. " + total.toLocaleString('id-ID');
        }

        function pesanSekarang() {
            let checkboxes = document.querySelectorAll('input[type="checkbox"]:checked');
            
            if (checkboxes.length === 0) {
                alert("Pilih minimal satu menu!");
                return;
            }

            let pesanan = "Pesanan Anda:\n\n";
            let total = 0;

            checkboxes.forEach(function(checkbox) {
                let label = document.querySelector('label[for="' + checkbox.id + '"]').textContent.split(/Rp\./)[0].trim();
                let harga = parseInt(checkbox.value);
                pesanan += "- " + label + ": Rp. " + harga.toLocaleString('id-ID') + "\n";
                total += harga;
            });

            pesanan += "\n" + "=".repeat(30) + "\n";
            pesanan += "Total Bayar: Rp. " + total.toLocaleString('id-ID') + "\n\n";
            pesanan += "Terima kasih telah memesan!";

            alert(pesanan);
        }

        function resetPesanan() {
            let checkboxes = document.querySelectorAll('input[type="checkbox"]');
            checkboxes.forEach(function(checkbox) {
                checkbox.checked = false;
            });
            hitungTotal();
        }

        // Initial call
        hitungTotal();
    </script>
</body>
</html>
